msgid "Home"
msgstr "Inicio"

msgid "RSVP"
msgstr "Confirmar asistencia"

msgid "Welcome"
msgstr "Bienvenidos"

msgid "Welcome to Our Wedding!"
msgstr "¡Bienvenidos a nuestra boda!"

msgid "We're getting married and we'd love for you to join us!"
msgstr "¡Nos casamos y nos encantaría que nos acompañaras!"

msgid "Wedding Website"
msgstr "Página de la boda"

msgid "Please enter your invitation code to RSVP."
msgstr "Introduce tu código de invitación para confirmar asistencia."

msgid "Invitation Code:"
msgstr "Código de invitación:"

msgid "Enter your code"
msgstr "Introduce tu código"

msgid "Continue"
msgstr "Continuar"

msgid "Confirm Guests"
msgstr "Confirmar invitados"

msgid "RSVP - Confirm Your Attendance"
msgstr "Confirmación de asistencia"

msgid "Country:"
msgstr "País:"

msgid "Current response:"
msgstr "Respuesta actual:"

msgid "Attending"
msgstr "Asistirá"

msgid "Not attending"
msgstr "No asistirá"

msgid "Pending"
msgstr "Pendiente"

msgid "Will you attend?"
msgstr "¿Asistirás?"

msgid "Yes, I'll be there!"
msgstr "¡Sí, allí estaré!"

msgid "Sorry, I can't make it"
msgstr "Lo siento, no podré asistir"

msgid "Update RSVP"
msgstr "Actualizar confirmación"

msgid "Submit RSVP"
msgstr "Enviar confirmación"

msgid "Enter a different code"
msgstr "Introducir otro código"

msgid "Guests on this invitation:"
msgstr "Invitados en esta invitación:"

msgid "Menu Choice"
msgstr "Elección de menú"

msgid "Dietary Restrictions / Allergies"
msgstr "Restricciones alimentarias / Alergias"

msgid "Notes"
msgstr "Notas"

msgid "Let us know where you are staying, information about children attending, or anything else we should know."
msgstr "Cuéntanos dónde te alojarás, información sobre niños que asistan, o cualquier otra cosa que debamos saber."

