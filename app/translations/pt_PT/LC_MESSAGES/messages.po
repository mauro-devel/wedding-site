#: app/routes/main.py
msgid "Invitation code not found. Please check and try again."
msgstr "Código de convite não encontrado. Verifica e tenta novamente."

#: app/routes/main.py
msgid ""
"You have already submitted a confirmation. You can update your response "
"below."
msgstr "Já enviaste uma confirmação. Podes atualizar a tua resposta em baixo."

#: app/routes/main.py
msgid "Please enter your invitation code first."
msgstr "Por favor, introduz primeiro o teu código de convite."

#: app/routes/main.py
msgid "RSVP submitted successfully!"
msgstr "Confirmação enviada com sucesso!"

